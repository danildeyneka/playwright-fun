{
  "name": "auto-hh",
  "version": "2.0.0",
  "author": "Danila Deyneka",
  "description": "Скрипт для автооткликов на hh",
  "main": "scripts/start.ts",
  "license": "MIT",
  "private": true,
  "scripts": {
    "init": "npx playwright install && $npm_execpath run renew-cookie && $npm_execpath run start",
    "init-zp": "npx playwright install && $npm_execpath run renew-cookie-zp && $npm_execpath run start-zp",
    "renew-cookie": "node --loader ts-node/esm scripts/save-hh-session.ts && $npm_execpath run start",
    "renew-cookie-zp": "node --loader ts-node/esm scripts/save-zp-session.ts && $npm_execpath run start-zp",
    "start": "node --loader ts-node/esm scripts/start.ts",
    "start-zp": "node --loader ts-node/esm scripts/start-zp.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "playwright": "^1.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "peerDependencies": {
    "typescript": "^5"
  }
}
